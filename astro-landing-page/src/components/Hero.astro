---
// filepath: /Users/sanduta/Documents/tum-web-lab2/astro-landing-page/src/components/Hero.astro
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__badge">🛒 Magazin local • Produse pentru fiecare zi</p>
      <h1 class="hero__title">
        Tot ce ai nevoie, <span class="hero__accent">aproape de casă</span>.
      </h1>
      <p class="hero__subtitle">
        Fructe și legume, cereale, băuturi, dulciuri și produse pentru curățenie —
        într-un singur loc, în Nisporeni.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Comandă / Întreabă</a>
        <a class="btn btn--ghost" href="#produse">Vezi ce găsești</a>
      </div>

      <ul class="hero__quick">
        <li>Produse de bază zilnice</li>
        <li>Prețuri atractive</li>
        <li>Suport rapid pe WhatsApp și Facebook</li>
      </ul>
    </div>

    <div class="hero__card" aria-label="Card informativ">
      <div class="heroCard">
        <div class="heroCard__top">
          <div>
            <h2 class="heroCard__title" style="color: #332317 !important;">Magazin Tipografia</h2>
            <p class="heroCard__meta" style="color: #593e2b !important;">Alexandru cel Bun 96, Nisporeni</p>
          </div>
        </div>

        <div class="heroCard__stats">
          <div class="stat">
            <span class="stat__k"></span>
            <span class="stat__v" style="color: #593e2b !important;">Legume & fructe</span>
          </div>
          <div class="stat">
            <span class="stat__k"></span>
            <span class="stat__v" style="color: #593e2b !important;">Cereale & conserve</span>
          </div>
          <div class="stat">
            <span class="stat__k"></span>
            <span class="stat__v" style="color: #593e2b !important;">Curățenie & casă</span>
          </div>
        </div>

        <div class="heroCard__actions">
          <a class="btn btn--small btn--primary" href="tel:+37379021721">Sună</a>
          <a class="btn btn--small btn--ghost" href="https://wa.me/37379021721" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a class="btn btn--small btn--ghost" href="https://www.facebook.com/p/Magazin-Tipografia-100077701992519/" target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>

        <div class="heroHours" aria-label="Orar scurt">
          <div class="heroHours__row"><span class="heroHours__k">Lun–Vin</span><span class="heroHours__v">08:00 – 18:00</span></div>
          <div class="heroHours__row"><span class="heroHours__k">Sâmbătă</span><span class="heroHours__v">08:00 – 16:00</span></div>
          <div class="heroHours__row"><span class="heroHours__k">Duminică</span><span class="heroHours__v">08:00 – 13:00</span></div>
          <a class="heroHours__link" href="#orar">Vezi orarul complet →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__wave" aria-hidden="true"></div>
</section>

<section class="mobileQuickContact">
  <div class="container">
    <h2 class="mobileQuickContact__title">📱 Comandă Rapid</h2>
    <p class="mobileQuickContact__text">Contactează-ne acum pentru comenzi sau întrebări</p>
    <div class="mobileQuickContact__buttons">
      <a class="btn btn--primary" href="https://wa.me/37379021721" target="_blank" rel="noopener noreferrer">💬 WhatsApp</a>
      <a class="btn btn--primary" href="tel:+37379021721">📞 Sună Acum</a>
    </div>
  </div>
</section>